# Скопировать в .env и вписать токен от @BotFather. В git не попадает.
VOLLEY_BOT_TOKEN=
# Необязательно: по умолчанию ~/.local/share/volley/state.db
VOLLEY_DB=
# Необязательно: id владельца бота. Ему можно настройки, даже если он не админ
# группы (повысить его там может только создатель). Пусто — значит только админам.
VOLLEY_OWNER_ID=
